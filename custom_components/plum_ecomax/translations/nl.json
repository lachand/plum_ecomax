    "issues": {
        "alarm_active": {
            "title": "Ketelalarm actief",
            "description": "De ketel meldt een actieve alarmbit op \"{slug}\". Raadpleeg het bedieningspaneel van de ketel voor de alarmcode en de reset. Deze integratie detecteert alleen dat er een bit is gezet; ze decodeert geen afzonderlijke alarmcodes."
        },
        "write_rejected": {
            "title": "Ketel weigerde een schrijfopdracht",
            "description": "Het schrijven van \"{slug}\" werd na 5 pogingen door de ketel geweigerd met resultaatcode {code} (bijv. 0x7D = authenticatiefout). Controleer het wachtwoord dat voor deze integratie is ingesteld en of de parameter in de huidige toestand wel beschrijfbaar is."
        },
        "connection_lost": {
            "title": "Verbinding met ketel verloren",
            "description": "{count} opeenvolgende pogingen om met de ketel te communiceren zijn mislukt. Controleer of de ketel aan staat en bereikbaar is op het ingestelde IP-adres/poort. Entiteiten tonen verouderde of onbeschikbare gegevens tot de verbinding is hersteld."
        },
        "manual_mode_stuck": {
            "title": "Ketel zit mogelijk vast in handmatige modus",
            "description": "De service solar_to_buffer kon de ketel niet terugzetten naar de automatische modus. In de handmatige modus is de automatische regeling uitgeschakeld. Zet de bedrijfsmodus terug op automatisch op het ecoSTER-paneel (of zet de schakelaar Handmatige modus uit) en controleer daarna de netwerkverbinding met de ketel."
        }
    },
    "services": {
        "set_schedule": {
            "name": "Wekelijks schema instellen",
            "description": "Overschrijft het wekelijkse comfort/eco-schema van een verwarmingscircuit of van het tapwater. Elk tijdstip buiten een comfortblok wordt eco.",
            "fields": {
                "circuit": {
                    "name": "Circuit",
                    "description": "Nummer van het verwarmingscircuit. Laat leeg voor tapwater."
                },
                "days": {
                    "name": "Dagen",
                    "description": "Op welke dagen dit schema geldt."
                },
                "comfort_blocks": {
                    "name": "Comfortblokken",
                    "description": "Lijst van tijdsbereiken (van/tot) die op comfort moeten staan. Een lege lijst zet de hele dag op eco."
                }
            }
        },
        "solar_to_buffer": {
            "name": "Zonne-ontlading naar buffer",
            "description": "Zet de ketel in de handmatige modus en forceert de tapwaterpomp gedurende een ingestelde tijd, en keert daarna terug naar automatisch. Verplaatst warmte van het zonnig opgewarmde tapwatervat naar de buffervaten.",
            "fields": {
                "duration": {
                    "name": "Duur",
                    "description": "Hoe lang de pomp wordt geforceerd, in minuten (maximaal 120)."
                },
                "start_temp": {
                    "name": "Starttemperatuur",
                    "description": "Overschrijft de ingestelde startdrempel voor deze aanroep. De ontlading start niet als het tapwatervat onder deze temperatuur ligt."
                },
                "stop_temp": {
                    "name": "Stoptemperatuur",
                    "description": "Overschrijft de ingestelde stopdrempel voor deze aanroep. De ontlading stopt zodra het tapwatervat tot deze temperatuur is gedaald."
                }
            }
        }
    },
    "exceptions": {
        "write_failed": {
            "message": "De ketel bevestigde het schrijven van {slug} niet; de vorige waarde is hersteld."
        },
        "write_rejected": {
            "message": "De ketel weigerde het schrijven van {slug} (code {code}). Controleer gebruikersnaam en wachtwoord via Opnieuw configureren."
        },
        "no_entry_loaded": {
            "message": "Er is geen Plum ecoMAX ingesteld of geladen."
        },
        "circuit_not_active": {
            "message": "Circuit {circuit} is geen actief circuit van een geladen Plum ecoMAX."
        },
        "schedule_not_supported": {
            "message": "Geen van de geladen ketels biedt een weekschema voor dat doel."
        }
    }
