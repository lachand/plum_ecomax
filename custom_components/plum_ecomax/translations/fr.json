    "issues": {
        "alarm_active": {
            "title": "Alarme chaudière active",
            "description": "La chaudière signale un bit d'alarme actif sur « {slug} ». Consultez le panneau physique pour le code d'alarme exact et la procédure de résolution -- cette intégration détecte seulement qu'un bit est levé, elle ne décode pas les codes d'alarme individuels."
        },
        "write_rejected": {
            "title": "Écriture rejetée par la chaudière",
            "description": "L'écriture de « {slug} » a été rejetée par la chaudière avec le code {code} (par exemple 0x7D = erreur d'authentification) après 5 tentatives. Vérifiez le mot de passe configuré pour cette intégration, et que le paramètre est bien modifiable dans son état actuel."
        },
        "connection_lost": {
            "title": "Connexion à la chaudière perdue",
            "description": "{count} tentatives consécutives de communication avec la chaudière ont échoué. Vérifiez que la chaudière est sous tension et joignable sur le réseau à l'adresse IP/port configurés -- les entités afficheront des données obsolètes ou indisponibles jusqu'au rétablissement de la connexion."
        },
        "manual_mode_stuck": {
            "title": "La chaudière est peut-être bloquée en mode manuel",
            "description": "Le service solar_to_buffer n'a pas pu remettre la chaudière en mode automatique. Tant qu'elle est en manuel, sa régulation automatique est désactivée. Repasse le mode de fonctionnement en automatique sur le panneau ecoSTER (ou désactive le commutateur « Mode manuel »), puis vérifie la connexion réseau vers la chaudière."
        }
    },
    "services": {
        "set_schedule": {
            "name": "Définir le planning hebdomadaire",
            "description": "Remplace le planning confort/éco hebdomadaire d'un circuit de chauffage ou de l'eau chaude sanitaire. Toute plage hors bloc confort passe en éco.",
            "fields": {
                "circuit": {
                    "name": "Circuit",
                    "description": "Numéro du circuit de chauffage. Laisser vide pour l'eau chaude sanitaire."
                },
                "days": {
                    "name": "Jours",
                    "description": "Jours auxquels ce planning s'applique."
                },
                "comfort_blocks": {
                    "name": "Blocs confort",
                    "description": "Liste de plages horaires (from/to) en mode confort. Une liste vide met toute la journée en éco."
                }
            }
        },
        "solar_to_buffer": {
            "name": "Décharge solaire vers tampon",
            "description": "Met la chaudière en mode manuel et force la pompe ECS pendant une durée donnée, puis revient en automatique. Déplace la chaleur du ballon ECS solaire vers les ballons tampons.",
            "fields": {
                "duration": {
                    "name": "Durée",
                    "description": "Durée du forçage de la pompe, en minutes (plafonnée à 120)."
                },
                "start_temp": {
                    "name": "Température de départ",
                    "description": "Remplace le seuil de départ configuré pour cet appel. La décharge n'est pas lancée si le ballon ECS est sous cette température."
                },
                "stop_temp": {
                    "name": "Température d'arrêt",
                    "description": "Remplace le seuil d'arrêt configuré pour cet appel. La décharge s'arrête dès que le ballon ECS descend à cette température."
                }
            }
        }
    }
