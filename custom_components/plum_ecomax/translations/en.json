    "issues": {
        "alarm_active": {
            "title": "Boiler alarm active",
            "description": "The boiler reports an active alarm bit on \"{slug}\". Check the boiler's control panel for the alarm code and how to clear it -- this integration only detects that some bit is set, it does not decode individual alarm codes."
        },
        "write_rejected": {
            "title": "Boiler rejected a write",
            "description": "Writing \"{slug}\" was rejected by the boiler with result code {code} (e.g. 0x7D = authentication error) after 5 attempts. Check the password configured for this integration, and that the parameter is actually writable in its current state."
        },
        "connection_lost": {
            "title": "Boiler connection lost",
            "description": "{count} consecutive attempts to talk to the boiler have failed. Check that the boiler is powered on and reachable on the network at the configured IP/port -- entities will show stale or unavailable data until connectivity is restored."
        },
        "manual_mode_stuck": {
            "title": "Boiler may be stuck in manual mode",
            "description": "The solar_to_buffer service could not return the boiler to automatic mode. While the boiler is in manual mode its automatic regulation is disabled. Set the operating mode back to automatic on the ecoSTER panel (or toggle the Manual mode switch off), then check the network connection to the boiler."
        }
    },
    "services": {
        "set_schedule": {
            "name": "Set weekly schedule",
            "description": "Overwrite the comfort/eco weekly schedule for a heating circuit or the domestic hot water. Any time not in a comfort block becomes eco.",
            "fields": {
                "circuit": {
                    "name": "Circuit",
                    "description": "Heating circuit number. Leave empty to target domestic hot water."
                },
                "days": {
                    "name": "Days",
                    "description": "Which days this schedule applies to."
                },
                "comfort_blocks": {
                    "name": "Comfort blocks",
                    "description": "List of from/to time ranges that should be in comfort mode. An empty list sets the whole day to eco."
                }
            }
        },
        "solar_to_buffer": {
            "name": "Solar dump to buffer",
            "description": "Put the boiler in manual mode and force the DHW pump for a set time, then return to automatic. Moves heat from the solar-charged DHW tank into the buffer tanks.",
            "fields": {
                "duration": {
                    "name": "Duration",
                    "description": "How long to force the pump, in minutes (capped at 120)."
                },
                "start_temp": {
                    "name": "Start temperature",
                    "description": "Override the configured start threshold for this call. The dump is not started if the DHW tank is below this temperature."
                },
                "stop_temp": {
                    "name": "Stop temperature",
                    "description": "Override the configured stop threshold for this call. The dump stops once the DHW tank drops to this temperature."
                }
            }
        }
    }
